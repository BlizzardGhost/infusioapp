# =============================================================================
# INFUSIO HEADLESS CMS - ENVIRONMENT CONFIGURATION
# =============================================================================

# Generative AI Secret Key for Automated SEO & Accessibility Hooks
PROCESS_AI_SECRET_KEY="your-gemini-or-openai-api-key"

# Generative AI Endpoint Configuration (Defaults to OpenAI-compatible Gemini or OpenAI endpoint)
AI_ENDPOINT_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
AI_MODEL_NAME="gemini-1.5-flash"

# CMS Encryption Secret
PAYLOAD_SECRET="generate-a-strong-32-byte-hex-string-for-production"

# Database Storage (SQLite file for local/edge, or libSQL/Turso URL)
DATABASE_URI="file:./cms-storage.db"

# Webhook Authentication Secret for External Automation
CMS_WEBHOOK_SECRET="infusio-secure-webhook-secret"

# Vercel Deployment Flags
ASTRO_TELEMETRY_DISABLED=1
