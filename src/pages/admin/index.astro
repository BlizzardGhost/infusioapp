---
import { AdminDashboard } from '../../../cms/components/AdminDashboard';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand-icon.svg" />
    <title>Infusio Studio CMS - Administrative Dashboard</title>
    <!-- Import Agency Custom CSS Theme Override -->
    <link rel="stylesheet" href="/cms/styles/admin-theme.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="margin: 0; padding: 0; background-color: #0B0F19;">
    <!-- Client-rendered White-Labeled Admin Dashboard Component Override -->
    <AdminDashboard client:load />
  </body>
</html>
