---
import { getUserBySession } from '../../../cms/auth/users';
import { AdminDashboard } from '../../../cms/components/AdminDashboard';
import { ClientDashboard } from '../../../cms/components/ClientDashboard';

export const prerender = false;

const sessionToken = Astro.cookies.get('infusio_auth_token')?.value;

if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const user = getUserBySession(sessionToken);

if (!user) {
  Astro.cookies.delete('infusio_auth_token', { path: '/' });
  return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand-icon.svg" />
    <title>
      {user.role === 'superadmin' ? 'Infusio Studio CMS - Master Dashboard' : `${user.assignedSite?.name || 'Client Workspace'} | Infusio CMS`}
    </title>
    <link rel="stylesheet" href="/cms/styles/admin-theme.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="margin: 0; padding: 0; background-color: #0e1113; font-family: 'Quicksand', sans-serif;">
    {user.role === 'superadmin' ? (
      <AdminDashboard user={{ name: user.displayName, identifier: user.identifier }} client:load />
    ) : (
      <ClientDashboard user={user} client:load />
    )}
  </body>
</html>
