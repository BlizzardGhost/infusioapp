---
import Layout from '../layouts/Layout.astro';
import { BrandLogo } from '../../cms/components/BrandLogo';

const serverRenderTime = new Date().toUTCString();
const deploymentEnv = process.env.VERCEL_ENV || 'production';
const targetRepo = 'BlizzardGhost/infusioapp';
---

<Layout title="Infusio Studio | Git-Based Headless CMS & Agent Control Plane">
  <div style="min-height: 100vh; display: flex; flex-direction: column;">
    <!-- Navigation Bar -->
    <header style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(11, 15, 17, 0.85); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
        <a href="/" style="display: flex; align-items: center; text-decoration: none;">
          <BrandLogo size="md" />
        </a>

        <nav style="display: flex; align-items: center; gap: 24px;">
          <a href="/articles" style="color: #a8b1c1; font-size: 0.9rem; font-weight: 500; transition: color 0.2s;">
            Articles & Insights
          </a>
          <a href="/admin" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 8px; background: linear-gradient(135deg, #13c296, #2dd4bf); color: #0b0f11; font-size: 0.875rem; font-weight: 700; text-decoration: none; box-shadow: 0 4px 14px rgba(19, 194, 150, 0.35);">
            Open Admin Dashboard ⚡
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <main style="flex: 1; max-width: 1200px; margin: 0 auto; padding: 72px 24px 48px; width: 100%; box-sizing: border-box;">
      <div style="text-align: center; max-width: 840px; margin: 0 auto 64px;">
        <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(19, 194, 150, 0.12); border: 1px solid rgba(19, 194, 150, 0.3); color: #2dd4bf; font-size: 0.8rem; font-weight: 700; margin-bottom: 24px;">
          <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #13c296; box-shadow: 0 0 8px #13c296;"></span>
          Matcha-Engineered Headless CMS & Multi-Repo Control Plane
        </div>

        <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 24px; color: #e8eef7;">
          Manage Every Site & App Under One Code-First Architecture
        </h1>

        <p style="font-size: 1.125rem; color: #a8b1c1; line-height: 1.6; margin-bottom: 36px;">
          Integrated with the Antigravity agent to orchestrate GitHub repositories under <code>BlizzardGhost/*</code>. Active test harness configured for <code>hero-wall-mvp</code> with automated generative AI enrichment.
        </p>

        <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
          <a href="/admin" style="padding: 14px 28px; border-radius: 10px; background: linear-gradient(135deg, #13c296 0%, #2dd4bf 100%); color: #0b0f11; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 16px rgba(19, 194, 150, 0.35);">
            Launch White-Labeled Dashboard
          </a>
          <a href="https://github.com/BlizzardGhost/hero-wall-mvp" target="_blank" style="padding: 14px 28px; border-radius: 10px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); color: #e8eef7; font-weight: 600; font-size: 0.95rem; text-decoration: none;">
            Inspect hero-wall-mvp ↗
          </a>
        </div>
      </div>

      <!-- Feature Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 64px;">
        <!-- Card 1 -->
        <div style="padding: 32px; border-radius: 16px; background: #14191d; border: 1px solid rgba(255, 255, 255, 0.08);">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">🍵</div>
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: #e8eef7;">
            Infusio Matcha Aesthetic
          </h2>
          <p style="color: #a8b1c1; font-size: 0.9rem; line-height: 1.6;">
            Aligned with the live <code>infusio-site</code> design system. Matcha jade, mint foam accents, dark obsidian surfaces, and total provider brand erasure.
          </p>
        </div>

        <!-- Card 2 -->
        <div style="padding: 32px; border-radius: 16px; background: #14191d; border: 1px solid rgba(255, 255, 255, 0.08);">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">🤖</div>
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: #e8eef7;">
            Antigravity Agent Connected
          </h2>
          <p style="color: #a8b1c1; font-size: 0.9rem; line-height: 1.6;">
            Connected agent API pipeline at <code>/api/agent/v1/*</code> enabling this agent to query, validate against schemas, and synchronize content across connected GitHub repos.
          </p>
        </div>

        <!-- Card 3 -->
        <div style="padding: 32px; border-radius: 16px; background: #14191d; border: 1px solid rgba(255, 255, 255, 0.08);">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">🛡️</div>
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: #e8eef7;">
            Hero Wall MVP Test Active
          </h2>
          <p style="color: #a8b1c1; font-size: 0.9rem; line-height: 1.6;">
            Managing <code>src/data/hero.json</code> and <code>hero.agent.json</code>. Enforces RASS protocol guardrails: planning in #0, execution in #11, structured JSON schema.
          </p>
        </div>
      </div>

      <!-- Realtime Edge Banner -->
      <div style="padding: 24px; border-radius: 12px; background: rgba(19, 194, 150, 0.06); border: 1px solid rgba(19, 194, 150, 0.2); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #2dd4bf;">
            Astro SSR & Git Pipeline
          </div>
          <div style="font-family: monospace; font-size: 0.85rem; color: #e8eef7; margin-top: 4px;">
            Target Repo: {targetRepo} • Synced: {serverRenderTime}
          </div>
        </div>

        <div style="display: flex; gap: 20px; font-family: monospace; font-size: 0.8rem; color: #a8b1c1;">
          <div>ENV: <span style="color: #13c296;">{deploymentEnv}</span></div>
          <div>ADAPTER: <span style="color: #2dd4bf;">@astrojs/vercel</span></div>
        </div>
      </div>
    </main>

    <!-- Global Footer -->
    <footer style="border-top: 1px solid rgba(255, 255, 255, 0.06); padding: 24px; text-align: center; color: #717d91; font-size: 0.85rem;">
      Infusio Studio • Centralized Headless Content Architecture • Antigravity Agent Integrated
    </footer>
  </div>
</Layout>
